{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "checkJs": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "tests", "*"],
  "exclude": ["src/service-worker"]
}
